{
  "name": "nico-toast",
  "version": "0.2.0",
  "description": "Framework-agnostic gooey, physics-based toast notifications. Works with Angular, React, Next.js, Vue, Nuxt, Svelte and plain JS.",
  "keywords": [
    "toast",
    "notification",
    "angular",
    "react",
    "vue",
    "svelte",
    "nextjs",
    "nuxt",
    "framework-agnostic"
  ],
  "homepage": "https://github.com/chanakya-nalajala/nico-toast#readme",
  "bugs": {
    "url": "https://github.com/chanakya-nalajala/nico-toast/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chanakya-nalajala/nico-toast.git"
  },
  "license": "MIT",
  "author": "Chanakya",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/gen-styles.mjs && tsup && node scripts/gen-styles.mjs",
    "typecheck": "node scripts/gen-styles.mjs && tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "module": "./dist/index.js",
  "sideEffects": [
    "*.css"
  ]
}
